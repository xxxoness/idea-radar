{
  "name": "idea-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply idea-radar-db --local",
    "db:migrate": "wrangler d1 migrations apply idea-radar-db --remote",
    "db:seed:local": "wrangler d1 execute idea-radar-db --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute idea-radar-db --remote --file=./seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.7.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wrangler": "^4.18.0"
  }
}
